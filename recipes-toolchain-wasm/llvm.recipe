import os
from cerbero.config import Platform


class Recipe(recipe.Recipe):
    name = 'llvm'
    version = '22.0.0'
    licenses = [License.Apachev2]
    btype = BuildType.CMAKE
    stype = SourceType.CUSTOM
    srcdir = 'llvm'
    deps = ['llvm-sources']
    cmake_options = [
        '-DLLVM_ENABLE_RUNTIMES="libcxx;libcxxabi;libunwind"',
        '-DLLVM_TARGETS_TO_BUILD="WebAssembly;X86"',
        '-DLLVM_INCLUDE_EXAMPLES=OFF',
        '-DLLVM_INCLUDE_TESTS=OFF',
        '-DCLANG_INCLUDE_TESTS=OFF',
        '-DLLVM_ENABLE_ASSERTIONS=OFF',
        '-DLLVM_ENABLE_LIBXML2=OFF',
        '-DLLVM_ENABLE_TERMINFO=OFF',
        '-DLLDB_ENABLE_LIBEDIT=OFF',
        '-DLLVM_ENABLE_LIBEDIT=OFF',
        '-DLLVM_ENABLE_LIBPFM=OFF',
        '-DLLVM_ENABLE_PROJECTS="clang;lld"',
        '-DLLVM_TEMPORARILY_ALLOW_OLD_TOOLCHAIN=ON',
        '-DCMAKE_BUILD_TYPE=Release'
    ]

    def prepare(self):
        if self.config.target_platform in [Platform.DARWIN, Platform.IOS]:
            self.cmake_options.append('-DCMAKE_OSX_DEPLOYMENT_TARGET=11.0')

        self.src_dir = os.path.join(self.config.sources, f'llvm-sources-{self.version}', 'llvm')
        self.config_src_dir = self.src_dir

        super().prepare()