class Recipe(recipe.Recipe):
    # This custom recipe fetches pre-built binaries from the gst.wasm/emsdk/4.0.22 branch, containing:
    # - https://github.com/llvm/llvm-project at 4.0.22 tag, plus
    # - commits in https://github.com/llvm/llvm-project/pull/153168
    name = 'llvm'
    stype = SourceType.TARBALL
    btype = BuildType.CUSTOM
    url = 'https://drive.usercontent.google.com/download?id=141UXuhew_4P9lBT9d1EFiHLN5ayGez34&confirm=t'
    tarball_name = "llvm.zip"
    tarball_checksum = '6ccb768e86e0bebdaa1ff48fe6c20ec1b50dfbf878505623a5168d3a99c7a4ab'
    tarball_is_bomb = True
    version = '0'
