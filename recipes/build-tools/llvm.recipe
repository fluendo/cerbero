    url = 'https://drive.usercontent.google.com/download?id=1dZ0in3VmKd89r9O--bGVS2Xvgrk_nBmt&confirm=t'
    tarball_name = "llvm.zip"
    tarball_checksum = 'c07d864f24f9a9fa5465f5132aab6aeb0917cf505b915dbaf06dfc7cf3ed180b'
    tarball_is_bomb = True
    version = '0'
